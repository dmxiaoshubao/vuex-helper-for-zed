{
  "name": "@dmxiaoshubao/vuex-helper-lsp",
  "version": "0.1.1",
  "description": "Vuex definition, completion, hover, and diagnostics support for Zed through vuex-helper LSP.",
  "license": "MIT",
  "main": "out/lsp/server.js",
  "files": [
    "out/adapters/",
    "out/core/",
    "out/lsp/",
    "out/providers/",
    "out/services/",
    "out/types/",
    "out/utils/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "start:lsp": "node ./out/lsp/server.js --stdio",
    "test:lsp": "npm run compile && mocha out/test/setup.js out/test/unit/*lsp*.test.js",
    "check:zed": "cargo check --manifest-path extensions/zed/Cargo.toml && cargo build --manifest-path extensions/zed/Cargo.toml --target wasm32-wasip1",
    "test:zed": "npm run test:lsp && npm run check:zed",
    "prepublishOnly": "npm run test:zed"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.1",
    "@types/mock-require": "^3.0.0",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "mocha": "^10.2.0",
    "mock-require": "^3.0.3",
    "proxyquire": "^2.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "glob": "^10.5.0",
    "json5": "^2.2.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
